# Скопируйте в .env и заполните своими значениями.
# .env не коммитится в репозиторий.

BOT_TOKEN=123456:YOUR_TELEGRAM_BOT_TOKEN
YOUR_TELEGRAM_ID=123456789

# Название организации для демо-документов
COMPANY_NAME=ООО «Демо-Строй»
COMPANY_SHORT_NAME=Демо-Строй

# Подпись мастера в реестре
REGISTRY_MASTER_NAME=Мастер

# Необязательно: ключ для экспериментального OCR-скрипта ai_worker.py
# AIAI_API_KEY=
